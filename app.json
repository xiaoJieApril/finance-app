{
  "expo": {
    "name": "finaTracker",
    "slug": "finance-app",
    "version": "1.2.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon-v2.png",
    "scheme": "financeapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#091223",
        "foregroundImage": "./assets/images/android-icon-foreground-v2.png",
        "backgroundImage": "./assets/images/android-icon-background-v2.png",
        "monochromeImage": "./assets/images/android-icon-monochrome-v2.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.xiaojieapril.financeapp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon-v2.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon-v2.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      "expo-sharing",
      "./plugins/withFinanceNotificationListener"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "enableNotificationImports": false,
      "eas": {
        "projectId": "0fb606b1-7c4c-4407-a733-c7ce54255d4b"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/0fb606b1-7c4c-4407-a733-c7ce54255d4b"
    },
    "owner": "xiaojieapril"
  }
}
