<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/cashflow_widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/cashflow_widget_background"
  android:orientation="vertical"
  android:padding="14dp">

  <TextView
    android:id="@+id/cashflow_widget_title"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="可用現金流"
    android:textColor="#c7d2fe"
    android:textSize="13sp"
    android:textStyle="bold" />

  <TextView
    android:id="@+id/cashflow_widget_amount"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:ellipsize="end"
    android:maxLines="1"
    android:text="RM ****"
    android:textColor="#ffffff"
    android:textSize="28sp"
    android:textStyle="bold" />

  <TextView
    android:id="@+id/cashflow_widget_subtitle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:ellipsize="end"
    android:maxLines="1"
    android:text="需要開啟 App 更新"
    android:textColor="#94a3b8"
    android:textSize="11sp" />

  <Button
    android:id="@+id/cashflow_widget_new_entry"
    android:layout_width="match_parent"
    android:layout_height="42dp"
    android:layout_marginTop="12dp"
    android:backgroundTint="#4f46e5"
    android:text="新增交易"
    android:textColor="#ffffff"
    android:textSize="13sp"
    android:textStyle="bold" />
</LinearLayout>
